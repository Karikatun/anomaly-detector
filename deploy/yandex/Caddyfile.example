(static_file_guard) {
	@hiddenFiles {
		path_regexp hiddenFiles (^|/)\.
		not path /.well-known/*
	}
	@hiddenWellKnown path_regexp hiddenWellKnown ^/\.well-known/(.*/)?\.
	@privateArtifacts path_regexp privateArtifacts (?i)\.(bak|backup|old|orig|save|swp|swo|tmp|sql|dump|zip|tar|tgz|gz|bz2|xz|7z|rar|key|pem|p12|pfx|map)(\.|/|$)|~($|/)
	respond @hiddenFiles 404
	respond @hiddenWellKnown 404
	respond @privateArtifacts 404
}

anomaly-detector.ru {
	@legacyPlayerRoutes {
		path /app /profile /feedback /rooms /rooms/* /tenders/* /tutorial /learn /recover/code /recover/password /privacy /personal-data-consent /terms
	}
	header @legacyPlayerRoutes Cache-Control "no-store"
	redir @legacyPlayerRoutes https://app.anomaly-detector.ru{uri} temporary

	root * {$ANOMALY_WEBSITE_ROOT}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' https://api.anomaly-detector.ru"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		-Server
	}

	@websiteAssets path /_astro/*
	header @websiteAssets Cache-Control "public, max-age=31536000, immutable"

	@websiteDocuments path / /index.html
	header @websiteDocuments Cache-Control "public, max-age=0, must-revalidate"

	route {
		import static_file_guard
		file_server
	}
}

app.anomaly-detector.ru {
	root * {$ANOMALY_WEBAPP_ROOT}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://api.anomaly-detector.ru wss://api.anomaly-detector.ru"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}

	@playerAssets path /assets/*
	header @playerAssets Cache-Control "public, max-age=31536000, immutable"

	route {
		import static_file_guard
		try_files {path} /index.html
		header /index.html Cache-Control "public, max-age=0, must-revalidate"
		file_server
	}
}

www.anomaly-detector.ru {
	redir https://anomaly-detector.ru{uri} permanent
}

ops.anomaly-detector.ru {
	basic_auth {
		{$ANOMALY_ADMIN_USER} {$ANOMALY_ADMIN_PASSWORD_HASH}
	}

	root * {$ANOMALY_ADMIN_ROOT}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; connect-src https://api.anomaly-detector.ru"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Cache-Control "no-store"
		-Server
	}

	route {
		import static_file_guard
		try_files {path} /index.html
		file_server
	}
}

api.anomaly-detector.ru {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy api:3000
}
