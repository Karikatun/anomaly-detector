{
  "name": "@anomaly-detector/webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "i18n:audit": "bun scripts/i18n-source-audit.mjs",
