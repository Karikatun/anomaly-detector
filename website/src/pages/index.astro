---
const title = 'Anomaly Detector'
const description = 'Соревновательная браузерная игра о научной дедукции и исследовании аномалии.'
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = publicWebsiteUrl
	? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
	: undefined
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#8b5cf6" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#02050d" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta name="twitter:card" content="summary" />
	</head>
	<body>
		<main>
			<section class="hero" aria-labelledby="page-title">
				<img
					class="brand-icon"
					src="/favicon.svg"
					width="112"
					height="112"
					alt=""
					aria-hidden="true"
				/>
				<p class="eyebrow">Научная дедукция · 2–4 игрока</p>
				<h1 id="page-title">Anomaly Detector</h1>
				<p class="summary">
					Исследуйте неизвестную аномалию, проверяйте гипотезы и находите
					единственно верное объяснение раньше соперников.
				</p>
			</section>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
		background: #02050d;
		color: #f8fafc;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background:
			radial-gradient(circle at 22% 38%, rgb(107 33 168 / 24%), transparent 32rem),
			radial-gradient(circle at 78% 70%, rgb(14 116 144 / 16%), transparent 30rem),
			#02050d;
	}

	main {
		min-height: 100vh;
		display: grid;
		align-items: center;
		padding: 3rem 1.5rem;
	}

	.hero {
		max-width: 720px;
	}

	.brand-icon {
		display: block;
		width: 7rem;
		height: 7rem;
		margin-bottom: 2rem;
		filter: drop-shadow(0 0 2rem rgb(168 85 247 / 30%));
	}

	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #c4b5fd;
	}

	h1 {
		margin: 0;
		font-size: clamp(3.25rem, 10vw, 7rem);
		line-height: 0.9;
		letter-spacing: -0.055em;
	}

	.summary {
		margin: 1.5rem 0 0;
		max-width: 580px;
		font-size: 1.125rem;
		line-height: 1.55;
		color: #aab5c5;
	}

	@media (min-width: 720px) {
		main {
			padding: 5rem;
		}

		.summary {
			font-size: 1.25rem;
		}
	}

	@media (min-width: 1120px) {
		main {
			padding: 6rem;
		}

	}
</style>
