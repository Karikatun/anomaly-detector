---
import reconnaissance from '../assets/landing/reconnaissance.png'
import laboratory from '../assets/landing/laboratory.png'
import completedTender from '../assets/landing/completed-tender.png'
import AnalyticsConsent from '../components/AnalyticsConsent.astro'

const title = 'Anomaly Detector — бесплатная браузерная игра на дедукцию'
const description = 'Исследуйте аномалию, проверяйте гипотезы и опередите соперников в научной игре на дедукцию для 2–4 друзей.'
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const publicWebappUrl = import.meta.env.PUBLIC_WEBAPP_URL
const analyticsApiUrl = import.meta.env.PUBLIC_ANALYTICS_API_URL
	? new URL(import.meta.env.PUBLIC_ANALYTICS_API_URL).origin
	: undefined
const analyticsCampaignAllowlist = (import.meta.env.PUBLIC_ANALYTICS_CAMPAIGN_ALLOWLIST ?? '')
	.split(',')
	.map((item: string) => item.trim().toLowerCase())
	.filter((item: string) => /^[a-z0-9_-]{1,64}$/.test(item))
const canonicalUrl = publicWebsiteUrl
	? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
	: undefined
const tutorialUrl = publicWebappUrl ? new URL('/?continue=tutorial', publicWebappUrl).toString() : '#launch-pending'
const loginUrl = publicWebappUrl ? new URL('/', publicWebappUrl).toString() : '#launch-pending'
const socialImageUrl = publicWebsiteUrl ? new URL(reconnaissance.src, publicWebsiteUrl).toString() : undefined
const socialImageAlt = 'Экран Разведки Anomaly Detector: выбор сигналов, игроки и Рабочая модель'
const legalUrl = (path: string) => publicWebappUrl ? new URL(path, publicWebappUrl).toString() : '#launch-pending'

const faq = [
	['Игра бесплатная?', 'Да. Участие в Anomaly Detector бесплатно.'],
	['Нужно что-то скачивать?', 'Нет. Игра работает прямо в современном браузере.'],
	['Сколько человек нужно для игры?', 'Для Тендера нужны 2–4 игрока. Перед первой партией можно пройти короткое одиночное обучение.'],
	['Нужна регистрация?', 'Да. Аккаунт сохраняет ваш прогресс и позволяет присоединяться к частным Тендерам.'],
	['Как пригласить друзей?', 'Создайте частный Тендер и передайте друзьям код приглашения. Посторонние игроки не увидят вашу комнату.'],
	['Как восстановить доступ?', 'Для аккаунта с паролем доступ можно восстановить через активную почту восстановления или сохранённый резервный код. Для аккаунта Яндекс ID вход и восстановление выполняются на стороне Яндекса.'],
] as const
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'VideoGame',
		name: 'Anomaly Detector',
		description,
		genre: ['Дедукция', 'Научная фантастика', 'Стратегия'],
		playMode: 'MultiPlayer',
		numberOfPlayers: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 4 },
		url: canonicalUrl,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebApplication',
		name: 'Anomaly Detector',
		applicationCategory: 'GameApplication',
		operatingSystem: 'Web browser',
		description,
		url: canonicalUrl,
		offers: { '@type': 'Offer', price: 0, priceCurrency: 'RUB' },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map(([name, text]) => ({
			'@type': 'Question',
			name,
			acceptedAnswer: { '@type': 'Answer', text },
		})),
	},
]
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#8b5cf6" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#02050d" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index,follow,max-image-preview:large" />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
		{socialImageUrl && <meta property="og:image:type" content="image/png" />}
		{socialImageUrl && <meta property="og:image:width" content={reconnaissance.width.toString()} />}
		{socialImageUrl && <meta property="og:image:height" content={reconnaissance.height.toString()} />}
		{socialImageUrl && <meta property="og:image:alt" content={socialImageAlt} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
		{socialImageUrl && <meta name="twitter:image:alt" content={socialImageAlt} />}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<header class="site-header">
					<a class="wordmark" href="#top" aria-label="Anomaly Detector — в начало">
						<span>Anomaly</span><strong>Detector</strong>
					</a>
					<nav aria-label="Основная навигация">
						<a href="#how">Как играть</a><a href="#why">Почему интересно</a><a href="#faq">FAQ</a>
					</nav>
					<a class="header-login" href={loginUrl}>Войти</a>
		</header>

		<main id="top" class="site-shell">
					<article class="landing">
						<section class="a-hero">
							<div class="a-copy">
								<p class="kicker">Научная дедукция · 2–4 игрока</p>
								<h1>Разгадайте аномалию раньше соперников</h1>
								<p class="lead">Научная игра на дедукцию для 2–4 друзей прямо в браузере. Освойте правила в коротком одиночном обучении.</p>
								<div class="actions">
									<a class="primary-action" href={tutorialUrl} data-analytics-event={analyticsApiUrl ? 'tutorial_cta' : undefined}>Пройти обучение</a>
									<a class="secondary-action" href="#how">Как проходит игра</a>
								</div>
								<p class="facts">Бесплатно · без скачивания · 2–4 игрока</p>
							</div>
							<figure class="screen-frame screen-frame-command">
								<div class="screen-status"><span>Тендер 01</span><span>Ваш ход</span></div>
								<img src={reconnaissance.src} width={reconnaissance.width} height={reconnaissance.height} alt="Экран разведки: игрок выбирает сигналы для получения образцов" fetchpriority="high" />
								<figcaption>Собирайте образцы. Соперники видят результат, но не ваши выводы.</figcaption>
							</figure>
						</section>
						{analyticsApiUrl && <AnalyticsConsent
							apiUrl={analyticsApiUrl}
							campaignAllowlist={analyticsCampaignAllowlist}
							privacyUrl={legalUrl('/privacy')}
						/>}
						<section id="how" class="a-cycle" aria-labelledby="cycle-title">
							<div><p class="section-index">01 / ЦИКЛ ИССЛЕДОВАНИЯ</p><h2 id="cycle-title">Каждый факт меняет вашу модель</h2></div>
							<ol>
								<li><span>01</span><strong>Исследуйте сигналы</strong><p>Получайте образцы, пока соперники борются за порядок действий.</p></li>
								<li><span>02</span><strong>Проверяйте гипотезы</strong><p>Проводите направленные опыты и собирайте личные измерения.</p></li>
								<li><span>03</span><strong>Опередите остальных</strong><p>Докажите тезисы, выполните Контракты и отправьте финальную модель.</p></li>
							</ol>
						</section>
						<section id="why" class="value-section" aria-labelledby="value-title">
							<div class="section-heading"><p class="section-index">02 / РЕШЕНИЯ</p><h2 id="value-title">Почему решения имеют вес</h2></div>
							<div class="value-grid">
								<article><span>01</span><h3>Ограниченная Мощность</h3><p>На всё ресурсов не хватит. Выбирайте, какой сигнал исследовать и когда рискнуть.</p></article>
								<article><span>02</span><h3>Приватные результаты</h3><p>Ваши измерения известны только вам. Соперники видят действия, но не выводы.</p></article>
								<article><span>03</span><h3>Контракты</h3><p>Превращайте верные гипотезы в очки, не раскрывая всю научную модель раньше времени.</p></article>
							</div>
						</section>
						<section class="a-proof" aria-label="Актуальные экраны игрового процесса">
							<figure class="screen-frame">
								<img src={laboratory.src} width={laboratory.width} height={laboratory.height} alt="Экран Лаборатории: выбор источника и приёмника направленного опыта" loading="lazy" />
								<figcaption><span>Фаза 04</span> Проверяйте направленные связи между сигналами.</figcaption>
							</figure>
							<figure class="screen-frame">
								<img src={completedTender.src} width={completedTender.width} height={completedTender.height} alt="Экран завершённого Тендера с итоговым рейтингом и научной моделью" loading="lazy" />
								<figcaption><span>Финал</span> Сравните модели и разберите начисленный Рейтинг.</figcaption>
							</figure>
						</section>
						<section class="journey" aria-labelledby="journey-title">
							<div class="section-heading"><p class="section-index">03 / ПЕРВЫЙ ЗАПУСК</p><h2 id="journey-title">От обучения к частному Тендеру</h2></div>
							<ol><li><span>01</span><strong>Пройдите обучение</strong><p>Разберите базовый цикл в одиночном сценарии.</p></li><li><span>02</span><strong>Создайте Тендер</strong><p>Настройте частную игровую комнату для своей компании.</p></li><li><span>03</span><strong>Пригласите друзей</strong><p>Передайте код и начните исследование, когда все готовы.</p></li></ol>
						</section>
						<section id="faq" class="faq" aria-labelledby="faq-title">
							<div class="section-heading"><p class="section-index">04 / ПЕРЕД СТАРТОМ</p><h2 id="faq-title">Частые вопросы</h2></div>
							<div class="faq-list">{faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
						</section>
						<section class="final-cta"><p class="kicker">Готовы начать исследование?</p><h2>Сначала — короткое обучение</h2><p>Освойте правила в одиночку, затем соберите друзей в частном Тендере.</p><a class="primary-action" href={tutorialUrl} data-analytics-event={analyticsApiUrl ? 'tutorial_cta' : undefined}>Пройти обучение</a></section>
					</article>
		</main>
		<footer><a class="wordmark" href="#top"><span>Anomaly</span><strong>Detector</strong></a><div><a href={legalUrl('/terms')}>Условия использования</a><a href={legalUrl('/privacy')}>Политика конфиденциальности</a><a href={legalUrl('/personal-data-consent')}>Согласие на обработку данных</a></div><a href="mailto:support@anomaly-detector.ru">support@anomaly-detector.ru</a></footer>
	</body>
</html>

<style>
	:root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #02050d; color: #f8fafc; }
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; min-width: 320px; min-height: 100vh; background: #02050d; }
	a { color: inherit; }
	button, a { -webkit-tap-highlight-color: transparent; }
	button:focus-visible, a:focus-visible { outline: 3px solid #7dd3fc; outline-offset: 4px; }
	[hidden] { display: none !important; }
	.site-header { position: sticky; top: 0; z-index: 10; display: flex; gap: 28px; align-items: center; justify-content: space-between; min-height: 72px; padding: 16px clamp(20px, 5vw, 72px); border-bottom: 1px solid rgb(148 163 184 / 14%); background: rgb(2 5 13 / 88%); backdrop-filter: blur(14px); }
	.site-header nav { display: flex; gap: 24px; margin-left: auto; }
	.site-header nav a { color: #94a3b8; font-size: .85rem; text-decoration: none; }
	.wordmark { display: flex; gap: 7px; align-items: baseline; text-decoration: none; text-transform: uppercase; letter-spacing: .08em; }
	.wordmark span { font-weight: 500; }
	.wordmark strong { color: #38bdf8; font-size: .75rem; letter-spacing: .13em; }
	.header-login, .secondary-action { color: #cbd5e1; font-size: .9rem; font-weight: 600; text-underline-offset: 5px; }
	.site-shell { overflow: clip; }
	.landing { min-height: calc(100vh - 72px); background: radial-gradient(circle at 78% 16%, rgb(14 116 144 / 20%), transparent 30rem), linear-gradient(150deg, #02050d 20%, #03111d); }
	.kicker, .section-index { margin: 0; color: #67e8f9; font: 600 .75rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .12em; text-transform: uppercase; }
	h1, h2, p { text-wrap: balance; }
	h1 { margin: 0; letter-spacing: -.045em; }
	h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.75rem); line-height: 1.02; letter-spacing: -.04em; }
	.lead { color: #aab5c5; font-size: clamp(1rem, 1.6vw, 1.2rem); line-height: 1.65; }
	.actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
	.primary-action, .secondary-action { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: 0 22px; border-radius: 8px; text-decoration: none; }
	.primary-action { background: #38bdf8; color: #07121a; font-weight: 750; box-shadow: 0 0 0 1px rgb(125 211 252 / 34%), 0 14px 40px rgb(14 165 233 / 18%); }
	.secondary-action { border: 1px solid rgb(148 163 184 / 25%); }
	.facts { margin: 0; color: #8391a5; font-size: .82rem; letter-spacing: .04em; }
	.screen-frame { margin: 0; overflow: hidden; border: 1px solid rgb(56 189 248 / 30%); border-radius: 10px; background: #03101c; box-shadow: 0 32px 90px rgb(0 0 0 / 50%); }
	.screen-frame img { display: block; width: 100%; height: auto; }
	.screen-frame figcaption { color: #9eafc3; font-size: .82rem; line-height: 1.5; }
	.screen-status { display: flex; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid rgb(56 189 248 / 18%); color: #7dd3fc; font: 600 .68rem/1 ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }

	.a-hero { display: grid; grid-template-columns: minmax(0, .85fr) minmax(480px, 1.15fr); gap: clamp(32px, 5vw, 84px); align-items: center; min-height: 72vh; padding: clamp(56px, 8vw, 112px) clamp(20px, 5vw, 72px); }
	.a-copy { display: grid; gap: 24px; max-width: 650px; }
	.a-copy h1 { font-size: clamp(3.2rem, 6vw, 6.5rem); line-height: .91; }
	.screen-frame-command { transform: perspective(1500px) rotateY(-3deg); }
	.screen-frame-command figcaption { padding: 12px 16px; }
	.a-cycle { display: grid; grid-template-columns: .75fr 1.25fr; gap: 48px; padding: 88px clamp(20px, 5vw, 72px) 128px; border-top: 1px solid rgb(56 189 248 / 18%); background: #030811; }
	.a-cycle > div { display: grid; align-content: start; gap: 16px; }
	.a-cycle ol { display: grid; gap: 1px; margin: 0; padding: 0; list-style: none; background: rgb(148 163 184 / 15%); }
	.a-cycle li { display: grid; grid-template-columns: 44px 1fr; gap: 8px 16px; padding: 24px; background: #050c16; }
	.a-cycle li > span { grid-row: 1 / 3; color: #38bdf8; font: 600 .8rem ui-monospace, monospace; }
	.a-cycle li strong { font-size: 1.05rem; }
	.a-cycle li p { margin: 0; color: #8795a8; line-height: 1.55; }
	.section-heading { display: grid; gap: 16px; max-width: 720px; }
	.value-section, .journey, .faq { padding: 96px clamp(20px, 5vw, 72px); background: #030811; }
	.value-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: 48px; background: rgb(148 163 184 / 15%); }
	.value-grid article { padding: 28px; background: #050c16; }
	.value-grid span, .journey li span { color: #38bdf8; font: 600 .72rem/1 ui-monospace, monospace; letter-spacing: .1em; }
	.value-grid h3 { margin: 24px 0 12px; font-size: 1.2rem; }
	.value-grid p, .journey li p { margin: 0; color: #8795a8; line-height: 1.6; }
	.a-proof { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); padding: 0 clamp(20px, 5vw, 72px) 128px; background: #030811; }
	.a-proof .screen-frame { box-shadow: 0 24px 70px rgb(0 0 0 / 42%); }
	.a-proof img { aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
	.a-proof figcaption { display: grid; grid-template-columns: auto 1fr; gap: 14px; padding: 14px 16px; }
	.a-proof figcaption span { color: #67e8f9; font: 600 .72rem/1.5 ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
	.journey ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 48px 0 0; padding: 0; list-style: none; }
	.journey li { display: grid; gap: 14px; padding: 26px 0; border-top: 1px solid rgb(56 189 248 / 28%); }
	.journey li strong { font-size: 1.1rem; }
	.faq { border-top: 1px solid rgb(148 163 184 / 14%); }
	.faq-list { margin-top: 48px; border-top: 1px solid rgb(148 163 184 / 18%); }
	.faq details { border-bottom: 1px solid rgb(148 163 184 / 18%); }
	.faq summary { padding: 22px 0; cursor: pointer; font-weight: 650; }
	.faq details p { max-width: 760px; margin: 0; padding: 0 0 24px; color: #94a3b8; line-height: 1.6; }
	.final-cta { display: grid; justify-items: center; gap: 20px; padding: 112px 20px; background: radial-gradient(circle, rgb(14 116 144 / 24%), transparent 34rem), #02050d; text-align: center; }
	.final-cta > p:not(.kicker) { max-width: 600px; margin: 0; color: #94a3b8; line-height: 1.6; }
	footer { display: flex; flex-wrap: wrap; gap: 28px 48px; align-items: center; justify-content: space-between; padding: 36px clamp(20px, 5vw, 72px); border-top: 1px solid rgb(148 163 184 / 14%); color: #94a3b8; font-size: .8rem; }
	footer > div { display: flex; flex-wrap: wrap; gap: 16px; }
	footer a { text-underline-offset: 4px; }

	@media (max-width: 900px) {
		.a-hero, .a-cycle, .a-proof { grid-template-columns: 1fr; }
		.value-grid, .journey ol { grid-template-columns: 1fr; }
		.a-hero { padding-top: 72px; }
		.screen-frame-command { transform: none; }
	}
	@media (max-width: 520px) {
		.site-header { min-height: 64px; }
		.site-header nav { display: none; }
		.landing { min-height: calc(100vh - 64px); }
		.wordmark { font-size: .86rem; }
		.a-copy h1 { font-size: clamp(2.7rem, 13vw, 4.2rem); }
		.a-hero { min-height: auto; padding-block: 56px 40px; }
		.a-cycle { padding-block: 64px 112px; }
		.actions { align-items: stretch; }
		.actions > a { width: 100%; }
		.a-proof img { aspect-ratio: 4 / 3; }
		.a-proof figcaption { grid-template-columns: 1fr; }
	}
	@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
