---
import reconnaissance from '../../../docs/ui/03-reconnaissance-desktop.png'
import laboratory from '../../../docs/ui/04-laboratory-desktop.png'
import completedTender from '../../../docs/ui/08-complete-desktop.png'

const title = 'Anomaly Detector'
const description = 'Соревновательная браузерная игра о научной дедукции и исследовании аномалии.'
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = publicWebsiteUrl
	? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
	: undefined
const isLandingPrototype = import.meta.env.DEV || import.meta.env.MODE === 'prototype'
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#8b5cf6" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#02050d" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta name="twitter:card" content="summary" />
	</head>
	<body>
		{isLandingPrototype ? (
			<>
				<!-- PROTOTYPE: three landing directions, switchable via ?variant=A|B|C. -->
				<header class="prototype-header">
					<a class="wordmark" href="#top" aria-label="Anomaly Detector — в начало">
						<span>Anomaly</span><strong>Detector</strong>
					</a>
					<a class="header-login" href="#prototype-note">Войти</a>
				</header>

				<main id="top" class="prototype-shell">
					<article class="variant variant-a" data-variant="A">
						<section class="a-hero">
							<div class="a-copy">
								<p class="kicker">Научная дедукция · 2–4 игрока</p>
								<h1>Разгадайте аномалию раньше соперников</h1>
								<p class="lead">Научная игра на дедукцию для 2–4 друзей прямо в браузере. Освойте правила в коротком одиночном обучении.</p>
								<div class="actions">
									<a class="primary-action" href="#prototype-note">Пройти обучение</a>
									<a class="secondary-action" href="#how-a">Как проходит игра</a>
								</div>
								<p class="facts">Бесплатно · без скачивания · 2–4 игрока</p>
							</div>
							<figure class="screen-frame screen-frame-command">
								<div class="screen-status"><span>Тендер 01</span><span>Ваш ход</span></div>
								<img src={reconnaissance.src} width={reconnaissance.width} height={reconnaissance.height} alt="Экран разведки: игрок выбирает сигналы для получения образцов" />
								<figcaption>Собирайте образцы. Соперники видят результат, но не ваши выводы.</figcaption>
							</figure>
						</section>
						<section id="how-a" class="a-cycle" aria-labelledby="cycle-a-title">
							<div><p class="section-index">01 / ЦИКЛ ИССЛЕДОВАНИЯ</p><h2 id="cycle-a-title">Каждый факт меняет вашу модель</h2></div>
							<ol>
								<li><span>01</span><strong>Исследуйте сигналы</strong><p>Получайте образцы, пока соперники борются за порядок действий.</p></li>
								<li><span>02</span><strong>Проверяйте гипотезы</strong><p>Проводите направленные опыты и собирайте личные измерения.</p></li>
								<li><span>03</span><strong>Опередите остальных</strong><p>Докажите тезисы, выполните Контракты и отправьте финальную модель.</p></li>
							</ol>
						</section>
					</article>

					<article class="variant variant-b" data-variant="B" hidden>
						<section class="b-hero">
							<p class="kicker">Досье AD–01 · открытый набор исследователей</p>
							<h1>У аномалии есть один ответ.<br /><em>Найдите его первым.</em></h1>
							<div class="b-intro">
								<p>Соревновательная браузерная игра, где каждый опыт даёт факты, а каждый факт — преимущество. Короткое обучение проведёт через первый научный Тендер.</p>
								<div class="actions"><a class="primary-action" href="#prototype-note">Пройти обучение</a><a class="text-link" href="#proof-b">Смотреть игровой процесс ↓</a></div>
							</div>
							<div class="b-ledger" aria-label="Основные свойства игры">
								<span><b>02–04</b> игрока</span><span><b>05</b> раундов</span><span><b>01</b> победитель</span><span><b>₽0</b> стоимость</span>
							</div>
						</section>
						<section id="proof-b" class="b-proof">
							<figure><img src={laboratory.src} width={laboratory.width} height={laboratory.height} alt="Экран лаборатории с выбором источника и приёмника опыта" /><figcaption><span>Фаза 04</span> Направленный опыт раскрывает общую закономерность и личное измерение.</figcaption></figure>
							<div class="b-principles">
								<p class="section-index">ПОЧЕМУ РЕШЕНИЯ ИМЕЮТ ВЕС</p>
								<h2>Данных всегда меньше, чем хочется</h2>
								<ul><li><strong>Ограниченная Мощность</strong><span>Нельзя исследовать всё за один раунд.</span></li><li><strong>Приватные выводы</strong><span>Соперники видят опыт, но не всю вашу информацию.</span></li><li><strong>Конкуренция за Контракты</strong><span>Доказательство приносит Рейтинг только тому, кто успел первым.</span></li></ul>
							</div>
						</section>
					</article>

					<article class="variant variant-c" data-variant="C" hidden>
						<section class="c-hero">
							<div class="c-orbit" aria-hidden="true"><span></span></div>
							<p class="kicker">Браузерная игра на дедукцию для компании</p>
							<h1>Разгадайте аномалию<br />раньше соперников</h1>
							<p class="lead">Начните с короткого одиночного обучения. Затем пригласите 1–3 друзей и проверьте, чья научная модель выдержит Тендер.</p>
							<div class="actions"><a class="primary-action" href="#prototype-note">Пройти обучение</a><a class="secondary-action" href="#journey-c">Показать путь игрока</a></div>
							<p class="facts">Бесплатно · без скачивания · 2–4 игрока</p>
						</section>
						<section id="journey-c" class="c-journey" aria-labelledby="journey-c-title">
							<div class="c-journey-copy">
								<p class="section-index">ОТ ПЕРВОГО ОПЫТА ДО ПОБЕДЫ</p><h2 id="journey-c-title">Научитесь в одиночку.<br />Победите в компании.</h2>
								<ol><li><span>01</span><div><strong>Пройдите обучение</strong><p>Два коротких раунда без таймера и штрафов.</p></div></li><li><span>02</span><div><strong>Создайте частный Тендер</strong><p>Отправьте код игры одному, двум или трём друзьям.</p></div></li><li><span>03</span><div><strong>Докажите свою модель</strong><p>Пять раундов решений, экспериментов и конкуренции.</p></div></li></ol>
							</div>
							<figure class="screen-frame screen-frame-result"><img src={completedTender.src} width={completedTender.width} height={completedTender.height} alt="Итоговый аудит завершённого Тендера с научными моделями игроков" /><figcaption>После матча участники видят полный аудит: где модель оказалась точной и за что начислен Рейтинг.</figcaption></figure>
						</section>
					</article>

					<section id="prototype-note" class="prototype-note" aria-label="Примечание о прототипе">
						<p><strong>Прототип.</strong> Кнопки показывают иерархию, но не запускают регистрацию. Выберите направление переключателем ниже.</p>
					</section>
				</main>

				<nav class="prototype-switcher" aria-label="Варианты прототипа">
					<button type="button" data-direction="previous" aria-label="Предыдущий вариант">←</button>
					<span data-variant-label aria-live="polite">A — Командный центр</span>
					<button type="button" data-direction="next" aria-label="Следующий вариант">→</button>
				</nav>
				<script>
					const variants = [
						{ key: 'A', name: 'Командный центр' },
						{ key: 'B', name: 'Научное досье' },
						{ key: 'C', name: 'Путь исследователя' },
					]
					const nodes = Array.from(document.querySelectorAll('[data-variant]'))
					const label = document.querySelector('[data-variant-label]')
					const readVariant = () => {
						const value = new URL(window.location.href).searchParams.get('variant')?.toUpperCase()
						return variants.findIndex(({ key }) => key === value)
					}
					let current = Math.max(0, readVariant())
					const render = (index: number) => {
						current = (index + variants.length) % variants.length
						const selected = variants[current]
						for (const node of nodes) node.toggleAttribute('hidden', node.getAttribute('data-variant') !== selected.key)
						if (label) label.textContent = `${selected.key} — ${selected.name}`
						const url = new URL(window.location.href)
						url.searchParams.set('variant', selected.key)
						window.history.replaceState(window.history.state, '', url)
						window.scrollTo({ top: 0, behavior: 'instant' })
					}
					document.querySelector('[data-direction="previous"]')?.addEventListener('click', () => render(current - 1))
					document.querySelector('[data-direction="next"]')?.addEventListener('click', () => render(current + 1))
					document.addEventListener('keydown', (event) => {
						const target = event.target
						if (target instanceof HTMLElement && (target.matches('input, textarea, [contenteditable]'))) return
						if (event.key === 'ArrowLeft') render(current - 1)
						if (event.key === 'ArrowRight') render(current + 1)
					})
					render(current)
				</script>
			</>
		) : (
			<main class="current-site">
				<section class="current-hero" aria-labelledby="page-title">
					<img class="brand-icon" src="/favicon.svg" width="112" height="112" alt="" aria-hidden="true" />
					<p class="kicker">Научная дедукция · 2–4 игрока</p>
					<h1 id="page-title">Anomaly Detector</h1>
					<p class="lead">Исследуйте неизвестную аномалию, проверяйте гипотезы и находите единственно верное объяснение раньше соперников.</p>
				</section>
			</main>
		)}
	</body>
</html>

<style>
	:root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #02050d; color: #f8fafc; }
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; min-width: 320px; min-height: 100vh; background: #02050d; }
	a { color: inherit; }
	button, a { -webkit-tap-highlight-color: transparent; }
	button:focus-visible, a:focus-visible { outline: 3px solid #7dd3fc; outline-offset: 4px; }
	[hidden] { display: none !important; }
	.prototype-header { position: relative; z-index: 10; display: flex; align-items: center; justify-content: space-between; min-height: 72px; padding: 16px clamp(20px, 5vw, 72px); border-bottom: 1px solid rgb(148 163 184 / 14%); background: rgb(2 5 13 / 88%); backdrop-filter: blur(14px); }
	.wordmark { display: flex; gap: 7px; align-items: baseline; text-decoration: none; text-transform: uppercase; letter-spacing: .08em; }
	.wordmark span { font-weight: 500; }
	.wordmark strong { color: #38bdf8; font-size: .75rem; letter-spacing: .13em; }
	.header-login, .secondary-action, .text-link { color: #cbd5e1; font-size: .9rem; font-weight: 600; text-underline-offset: 5px; }
	.prototype-shell { overflow: clip; }
	.variant { min-height: calc(100vh - 72px); }
	.kicker, .section-index { margin: 0; color: #67e8f9; font: 600 .75rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .12em; text-transform: uppercase; }
	h1, h2, p { text-wrap: balance; }
	h1 { margin: 0; letter-spacing: -.045em; }
	h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.75rem); line-height: 1.02; letter-spacing: -.04em; }
	.lead { color: #aab5c5; font-size: clamp(1rem, 1.6vw, 1.2rem); line-height: 1.65; }
	.actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
	.primary-action, .secondary-action { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: 0 22px; border-radius: 8px; text-decoration: none; }
	.primary-action { background: #38bdf8; color: #07121a; font-weight: 750; box-shadow: 0 0 0 1px rgb(125 211 252 / 34%), 0 14px 40px rgb(14 165 233 / 18%); }
	.secondary-action { border: 1px solid rgb(148 163 184 / 25%); }
	.facts { margin: 0; color: #8391a5; font-size: .82rem; letter-spacing: .04em; }
	.screen-frame { margin: 0; overflow: hidden; border: 1px solid rgb(56 189 248 / 30%); border-radius: 10px; background: #03101c; box-shadow: 0 32px 90px rgb(0 0 0 / 50%); }
	.screen-frame img { display: block; width: 100%; height: auto; }
	.screen-frame figcaption { color: #9eafc3; font-size: .82rem; line-height: 1.5; }
	.screen-status { display: flex; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid rgb(56 189 248 / 18%); color: #7dd3fc; font: 600 .68rem/1 ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }

	.variant-a { background: radial-gradient(circle at 78% 16%, rgb(14 116 144 / 20%), transparent 30rem), linear-gradient(150deg, #02050d 20%, #03111d); }
	.a-hero { display: grid; grid-template-columns: minmax(0, .85fr) minmax(480px, 1.15fr); gap: clamp(32px, 5vw, 84px); align-items: center; min-height: 72vh; padding: clamp(56px, 8vw, 112px) clamp(20px, 5vw, 72px); }
	.a-copy { display: grid; gap: 24px; max-width: 650px; }
	.a-copy h1 { font-size: clamp(3.2rem, 6vw, 6.5rem); line-height: .91; }
	.screen-frame-command { transform: perspective(1500px) rotateY(-3deg); }
	.screen-frame-command figcaption { padding: 12px 16px; }
	.a-cycle { display: grid; grid-template-columns: .75fr 1.25fr; gap: 48px; padding: 88px clamp(20px, 5vw, 72px) 128px; border-top: 1px solid rgb(56 189 248 / 18%); background: #030811; }
	.a-cycle > div { display: grid; align-content: start; gap: 16px; }
	.a-cycle ol { display: grid; gap: 1px; margin: 0; padding: 0; list-style: none; background: rgb(148 163 184 / 15%); }
	.a-cycle li { display: grid; grid-template-columns: 44px 1fr; gap: 8px 16px; padding: 24px; background: #050c16; }
	.a-cycle li > span { grid-row: 1 / 3; color: #38bdf8; font: 600 .8rem ui-monospace, monospace; }
	.a-cycle li strong { font-size: 1.05rem; }
	.a-cycle li p { margin: 0; color: #8795a8; line-height: 1.55; }

	.variant-b { background: #e7e4dc; color: #111827; }
	.variant-b .kicker, .variant-b .section-index { color: #0e7490; }
	.b-hero { padding: clamp(60px, 9vw, 132px) clamp(20px, 7vw, 110px) 56px; border-bottom: 1px solid #a8a49b; }
	.b-hero h1 { max-width: 1200px; margin-top: 30px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(3.4rem, 8vw, 8.5rem); font-weight: 400; line-height: .87; }
	.b-hero h1 em { color: #0e7490; font-weight: inherit; }
	.b-intro { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 48px; align-items: end; max-width: 980px; margin: 56px 0 44px auto; }
	.b-intro > p { margin: 0; max-width: 610px; font-size: 1.15rem; line-height: 1.65; }
	.variant-b .primary-action { background: #083344; color: #ecfeff; box-shadow: none; }
	.variant-b .text-link { color: #164e63; }
	.b-ledger { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid #aaa69d; }
	.b-ledger span { display: grid; gap: 5px; padding: 20px 0; border-right: 1px solid #aaa69d; color: #52525b; font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; }
	.b-ledger span:last-child { border-right: 0; }
	.b-ledger b { color: #111827; font: 500 1.7rem/1 Georgia, serif; }
	.b-proof { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(340px, .75fr); }
	.b-proof figure { margin: 0; padding: clamp(24px, 5vw, 72px); background: #07101a; color: #dbeafe; }
	.b-proof figure img { display: block; width: 100%; height: auto; border: 1px solid rgb(56 189 248 / 28%); }
	.b-proof figcaption { display: grid; grid-template-columns: 80px 1fr; gap: 16px; margin-top: 16px; color: #94a3b8; line-height: 1.5; }
	.b-proof figcaption span { color: #67e8f9; font: .72rem ui-monospace, monospace; text-transform: uppercase; }
	.b-principles { padding: clamp(48px, 7vw, 100px) clamp(24px, 5vw, 72px); }
	.b-principles h2 { margin-top: 18px; font-family: Georgia, serif; font-weight: 400; }
	.b-principles ul { display: grid; gap: 0; margin: 48px 0 0; padding: 0; list-style: none; border-top: 1px solid #aaa69d; }
	.b-principles li { display: grid; gap: 7px; padding: 20px 0; border-bottom: 1px solid #aaa69d; }
	.b-principles li span { color: #57534e; line-height: 1.5; }

	.variant-c { background: radial-gradient(circle at 50% 12%, rgb(76 29 149 / 34%), transparent 27rem), #02050d; }
	.c-hero { position: relative; display: grid; place-items: center; min-height: 78vh; padding: 72px 20px; text-align: center; isolation: isolate; }
	.c-orbit { position: absolute; z-index: -1; width: min(62vw, 720px); aspect-ratio: 1; border: 1px solid rgb(167 139 250 / 17%); border-radius: 50%; box-shadow: inset 0 0 90px rgb(76 29 149 / 10%); }
	.c-orbit::before, .c-orbit::after { position: absolute; inset: 12%; content: ''; border: 1px solid rgb(56 189 248 / 12%); border-radius: 50%; transform: rotate(37deg) scaleY(.42); }
	.c-orbit::after { inset: 24%; border-color: rgb(167 139 250 / 23%); transform: rotate(-28deg) scaleY(.5); }
	.c-orbit span { position: absolute; inset: 42%; border: 1px solid rgb(103 232 249 / 48%); border-radius: 50%; background: rgb(56 189 248 / 8%); box-shadow: 0 0 60px rgb(56 189 248 / 22%); }
	.c-hero h1 { margin: 26px 0 22px; font-size: clamp(3.1rem, 7.5vw, 7.5rem); line-height: .92; }
	.c-hero .lead { max-width: 700px; margin: 0 0 28px; }
	.c-hero .facts { margin-top: 18px; }
	.c-journey { display: grid; grid-template-columns: minmax(350px, .72fr) minmax(0, 1.28fr); gap: clamp(36px, 6vw, 90px); align-items: center; padding: 96px clamp(20px, 6vw, 90px) 140px; border-top: 1px solid rgb(167 139 250 / 16%); background: linear-gradient(180deg, #030712, #02050d); }
	.c-journey-copy { display: grid; gap: 22px; }
	.c-journey ol { display: grid; gap: 0; margin: 28px 0 0; padding: 0; list-style: none; }
	.c-journey li { display: grid; grid-template-columns: 54px 1fr; gap: 14px; padding: 20px 0; border-top: 1px solid rgb(148 163 184 / 16%); }
	.c-journey li > span { color: #a78bfa; font: 500 .78rem ui-monospace, monospace; }
	.c-journey li strong { font-size: 1rem; }
	.c-journey li p { margin: 7px 0 0; color: #8997a9; line-height: 1.5; }
	.screen-frame-result img { aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
	.screen-frame-result figcaption { padding: 16px 18px; }

	.prototype-note { padding: 32px 20px 110px; background: #02050d; color: #94a3b8; text-align: center; }
	.prototype-note p { margin: 0 auto; max-width: 760px; line-height: 1.55; }
	.prototype-switcher { position: fixed; z-index: 100; bottom: 18px; left: 50%; display: grid; grid-template-columns: 44px minmax(180px, auto) 44px; align-items: center; padding: 6px; border: 1px solid rgb(125 211 252 / 42%); border-radius: 999px; background: rgb(2 6 23 / 96%); color: #e2e8f0; box-shadow: 0 12px 50px rgb(0 0 0 / 60%); transform: translateX(-50%); }
	.prototype-switcher button { width: 44px; height: 44px; border: 0; border-radius: 999px; background: transparent; color: #7dd3fc; font-size: 1.2rem; cursor: pointer; }
	.prototype-switcher button:hover { background: rgb(56 189 248 / 12%); }
	.prototype-switcher span { padding: 0 12px; font-size: .78rem; font-weight: 650; text-align: center; letter-spacing: .04em; }
	.current-site { display: grid; min-height: 100vh; align-items: center; padding: 3rem 1.5rem; background: radial-gradient(circle at 22% 38%, rgb(107 33 168 / 24%), transparent 32rem), radial-gradient(circle at 78% 70%, rgb(14 116 144 / 16%), transparent 30rem), #02050d; }
	.current-hero { max-width: 720px; }
	.current-hero h1 { font-size: clamp(3.25rem, 10vw, 7rem); line-height: .9; }
	.brand-icon { display: block; width: 7rem; height: 7rem; margin-bottom: 2rem; filter: drop-shadow(0 0 2rem rgb(168 85 247 / 30%)); }
	.current-hero .lead { max-width: 580px; }

	@media (max-width: 900px) {
		.a-hero, .a-cycle, .b-proof, .c-journey { grid-template-columns: 1fr; }
		.a-hero { padding-top: 72px; }
		.screen-frame-command { transform: none; }
		.b-intro { grid-template-columns: 1fr; gap: 24px; margin-left: 0; }
		.b-ledger { grid-template-columns: repeat(2, 1fr); }
		.b-ledger span:nth-child(2) { border-right: 0; }
