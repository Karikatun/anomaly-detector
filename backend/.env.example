# Local PostgreSQL from ../docker-compose.yml.
# Keep an explicit username and password in Prisma URLs even on local machines.
# Peer-auth style URLs without a user can produce opaque Prisma schema-engine errors.
DATABASE_URL="postgresql://superuser:superpassword@localhost:54329/anomaly_detector?schema=public"
# Defaults to PORT + 1 when omitted. Keep this port private to the runtime network.
# WORKER_HEALTH_PORT="3001"

# Test PostgreSQL from ../docker-compose.yml. Backend integration, Docker smoke,
# and Playwright E2E use this shape and must target the *_test database.
TEST_DATABASE_URL="postgresql://superuser:superpassword@localhost:54330/anomaly_detector_test?schema=public"

JWT_SECRET="replace-with-at-least-32-random-characters"
# Comma-separated immutable user UUIDs. Empty disables the operator surface.
ADMIN_USER_IDS=""
# First-party journey analytics is disabled until legal approval and split-domain
# production verification are complete. When enabled, list only the exact public
# landing and player app origins. Campaign values are safe slugs, never arbitrary UTM.
ANALYTICS_ENABLED="false"
ANALYTICS_ORIGINS=""
ANALYTICS_CAMPAIGN_ALLOWLIST=""
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:19006"
# Exact player-browser origin used for OAuth return redirects. Required in
# production-like runtimes and must also be present in CORS_ORIGINS.
WEBAPP_ORIGIN="http://localhost:5173"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"
REFRESH_REUSE_GRACE_SECONDS="10"
SESSION_ABSOLUTE_TTL_DAYS="90"
SESSION_RETENTION_DAYS="7"
# Historical name retained for deployment compatibility; enforced for every API request body.
AUTH_BODY_LIMIT_BYTES="65536"
AUTH_RATE_LIMIT_MAX="60"
AUTH_RATE_LIMIT_WINDOW_SECONDS="60"
# Optional distributed PostgreSQL anti-abuse overrides. The values shown are
# the built-in defaults; omit an override to keep its default. Change them only
# from production evidence, not as an incident workaround.
ANTI_ABUSE_LOGIN_FAILURE_LIMIT="5"
ANTI_ABUSE_LOGIN_IP_LIMIT="30"
ANTI_ABUSE_REGISTRATION_DEVICE_LIMIT="3"
ANTI_ABUSE_REGISTRATION_IP_LIMIT="20"
ANTI_ABUSE_RECOVERY_EMAIL_MINUTE_LIMIT="1"
ANTI_ABUSE_RECOVERY_EMAIL_HOUR_LIMIT="3"
ANTI_ABUSE_RECOVERY_EMAIL_DAY_LIMIT="5"
ANTI_ABUSE_RECOVERY_EMAIL_IP_HOUR_LIMIT="20"
ANTI_ABUSE_RECOVERY_LOGIN_HOUR_LIMIT="3"
ANTI_ABUSE_RECOVERY_LOGIN_DAY_LIMIT="5"
ANTI_ABUSE_RECOVERY_LOGIN_IP_HOUR_LIMIT="10"
ANTI_ABUSE_RECOVERY_LOGIN_IP_DAY_LIMIT="30"
ANTI_ABUSE_AUTHENTICATED_MUTATION_LIMIT="120"
ANTI_ABUSE_ROOM_JOIN_LIMIT="20"
ANTI_ABUSE_TENDER_COMMAND_LIMIT="60"
ANTI_ABUSE_REALTIME_TICKET_LIMIT="10"
SHUTDOWN_GRACE_SECONDS="20"
TRUST_PROXY="false"
# Required when TRUST_PROXY=true. Yandex Application Load Balancer supplies X-Forwarded-For.
# Use the first value from the comma-separated proxy chain.
# TRUSTED_PROXY_CLIENT_IP_HEADER="x-forwarded-for"
# TRUSTED_PROXY_CLIENT_IP_POSITION="first"
COOKIE_SECURE="false"

# Transactional mail through the dedicated REG.RU mailbox. Disabled preserves
# queued PostgreSQL rows without contacting SMTP. When any connection field is
# set, the complete TLS configuration is required. Keep the real password only
# in production secrets; never put it in this file or shell history.
MAIL_SMTP_ENABLED="false"
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT=""
# Allowed values: implicit_tls, starttls. Plaintext SMTP is not supported.
MAIL_SMTP_TLS_MODE=""
MAIL_SMTP_USERNAME=""
MAIL_SMTP_PASSWORD=""
# When configured, these are fixed to no-reply@anomaly-detector.ru and
# support@anomaly-detector.ru respectively.
MAIL_SMTP_FROM=""
MAIL_SMTP_REPLY_TO=""
# The lease must be longer than the SMTP timeout so another worker cannot
# reclaim a message while the first SMTP attempt is still in progress.
MAIL_SMTP_TIMEOUT_MS="10000"
MAIL_SMTP_MAX_ATTEMPTS="5"
MAIL_SMTP_RETRY_BASE_SECONDS="30"
MAIL_SMTP_CIRCUIT_FAILURE_THRESHOLD="5"
MAIL_SMTP_CIRCUIT_OPEN_SECONDS="300"
MAIL_SMTP_DELIVERY_BUDGET_PER_MINUTE="60"
MAIL_SMTP_LEASE_SECONDS="60"
MAIL_SMTP_WORKER_INTERVAL_MS="1000"
MAIL_OUTBOX_RETENTION_DAYS="30"

# OAuth provider: Yandex ID. Leave blank to disable OAuth sign-in.
YANDEX_OAUTH_CLIENT_ID=""
YANDEX_OAUTH_CLIENT_SECRET=""
# Required when Yandex ID is enabled. This is the public API origin,
# registered at the provider; callbacks are fixed to /api/auth/oauth/<provider>/callback.
OAUTH_CALLBACK_BASE_URL=""

# Optional Yandex Object Storage. Leave blank until the product needs
# uploads, media, or other persistent files.
YANDEX_STORAGE_REGION="ru-central1"
YANDEX_STORAGE_BUCKET=""
YANDEX_STORAGE_ENDPOINT="https://storage.yandexcloud.net"
YANDEX_STORAGE_CDN_BASE_URL=""
YANDEX_STORAGE_ACCESS_KEY_ID=""
YANDEX_STORAGE_SECRET_ACCESS_KEY=""
YANDEX_STORAGE_UPLOAD_MAX_BYTES="10485760"
YANDEX_STORAGE_UPLOAD_URL_TTL_SECONDS="900"
YANDEX_STORAGE_DOWNLOAD_URL_TTL_SECONDS="300"
YANDEX_STORAGE_PUBLIC_CACHE_CONTROL="public, max-age=31536000, immutable"
